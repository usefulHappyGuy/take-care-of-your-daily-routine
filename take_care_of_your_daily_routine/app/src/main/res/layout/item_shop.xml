<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Ikona przedmiotu -->
    <ImageView
        android:id="@+id/ivItemIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="Ikona przedmiotu"
        android:src="@drawable/freeze"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Nazwa przedmiotu -->
    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="zamrożenie Passy na jeden dzień"
        android:textSize="18sp"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="@id/ivItemIcon"
        app:layout_constraintStart_toEndOf="@id/ivItemIcon"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cena przedmiotu -->
    <TextView
        android:id="@+id/tvItemPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Cena: 500"
        android:textSize="16sp"
        android:textColor="#555555"
        app:layout_constraintTop_toBottomOf="@id/tvItemName"
        app:layout_constraintStart_toStartOf="@id/tvItemName"
        app:layout_constraintEnd_toEndOf="@id/tvItemName" />

    <!-- Przycisk zakupu -->
    <Button
        android:id="@+id/btnBuy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="Kup"
        app:layout_constraintTop_toBottomOf="@id/tvItemPrice"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
